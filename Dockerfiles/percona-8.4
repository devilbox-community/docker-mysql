# vi: ft=dockerfile
FROM percona/percona-server:8.4

USER root
RUN set -eux \
    && mkdir -p /etc/mysql/conf.d/ /etc/mysql/docker-default.d/ \
    && if [ -f /etc/my.cnf ]; then \
        echo '!'"includedir /etc/mysql/conf.d/" >> /etc/my.cnf; \
        echo '!'"includedir /etc/mysql/docker-default.d/" >> /etc/my.cnf; \
    elif [ -f /etc/mysql/my.cnf ]; then \
        echo '!'"includedir /etc/mysql/docker-default.d/" >> /etc/mysql/my.cnf; \
    else \
        echo "/etc/my.cnf and /etc/mysql/my.cnf are not available"; \
        false; \
    fi \
# Allow native password handling for MySQL 8.4 (default-authentication-plugin was removed)
    && sed -i'' "s|^pid-file=.*$|pid-file=/var/run/mysqld/mysqld.pid\nmysql_native_password=ON\nauthentication_policy=mysql_native_password|g" /etc/my.cnf \
    && if [ -f "/entrypoint.sh" ]; then \
        mv "/entrypoint.sh" "/docker-entrypoint.sh"; \
    fi \
    && if [ ! -f "/docker-entrypoint.sh" ]; then \
        ln -s "/usr/local/bin/docker-entrypoint.sh" "/docker-entrypoint.sh"; \
    fi \
    && chmod +x "/docker-entrypoint.sh"

USER mysql
ENTRYPOINT ["/docker-entrypoint.sh"]
CMD ["mysqld"]
